# Template. Copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed. This template must never
# contain a real value.
#
# The scripts read .env directly, so there is nothing to source. Do NOT use
# `set -a && . ./.env && set +a`: the shell mangles any value containing
# characters like & or $, which is exactly what a good password contains, and
# the variable then arrives empty, which looks like a missing credential.
#
# Values are taken literally, so quoting is optional and never required. A
# real exported environment variable still wins over this file.

# Base URL of the DHIS2 instance, no trailing slash.
DHIS2_URL=https://t2d-registry.plhi.us

# Account used by the metadata and import scripts. Needs write access.
DHIS2_USERNAME=
DHIS2_PASSWORD=

# Read-only account for the scripts in "7. verification data script".
# Falls back to DHIS2_USERNAME / DHIS2_PASSWORD when unset. Prefer a genuinely
# read-only account here: those scripts pass read_only=True, but that only
# selects which credential is used, it cannot restrict an account that has
# write permission.
DHIS2_AUDITOR_USER=
DHIS2_AUDITOR_PASS=

# Root of the AI-READI dataset. On the JupyterHub server:
AIREADI_ROOT=/data0/AI-READI/full_subset
